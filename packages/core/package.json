{
  "name": "@orthogea/core",
  "version": "0.3.0",
  "description": "Core types, Zod schemas and spatial helpers (BBox, CRS, NUTS) for OrthoGea - Europe.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eisii42/OrthoGea---Europe.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/eisii42/OrthoGea---Europe/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/eisii42/OrthoGea---Europe/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
