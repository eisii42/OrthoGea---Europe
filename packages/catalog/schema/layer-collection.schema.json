{
  "title": "LayerCollection",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "orthophoto",
              "satellite",
              "cadastre",
              "elevation",
              "land_use",
              "custom"
            ]
          },
          "provider": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "shortName": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name"
            ]
          },
          "country": {
            "type": "string"
          },
          "nuts": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{0,3}$"
          },
          "regionName": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "additionalItems": false,
            "minItems": 4,
            "maxItems": 4,
            "description": "[minLng, minLat, maxLng, maxLat] in WGS84 degrees"
          },
          "coverage": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "array",
              "items": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "additionalItems": false,
              "minItems": 4,
              "maxItems": 4,
              "description": "[minLng, minLat, maxLng, maxLat] in WGS84 degrees"
            }
          },
          "service": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "WMS"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "layers": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "styles": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "format": {
                        "default": "image/png",
                        "type": "string",
                        "pattern": "^image\\/[a-z0-9+.\\-]+(;\\s*[a-z0-9\\-]+=[a-z0-9\\-]+)?$"
                      },
                      "infoFormats": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 3
                        }
                      },
                      "crs": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 3
                        }
                      },
                      "version": {
                        "default": "1.3.0",
                        "type": "string",
                        "enum": [
                          "1.1.0",
                          "1.1.1",
                          "1.3.0"
                        ]
                      },
                      "queryable": {
                        "default": false,
                        "type": "boolean"
                      },
                      "transparent": {
                        "default": true,
                        "type": "boolean"
                      },
                      "tileSize": {
                        "default": 256,
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 256
                          },
                          {
                            "type": "number",
                            "const": 512
                          }
                        ]
                      },
                      "time": {
                        "type": "string"
                      },
                      "maxWidth": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "maxHeight": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "extraParams": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      }
                    },
                    "required": [
                      "layers"
                    ]
                  }
                },
                "required": [
                  "type",
                  "url",
                  "options"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "WMTS"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "layer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "tileMatrixSet": {
                        "type": "string",
                        "minLength": 1
                      },
                      "style": {
                        "default": "default",
                        "type": "string"
                      },
                      "format": {
                        "default": "image/png",
                        "type": "string",
                        "pattern": "^image\\/[a-z0-9+.\\-]+(;\\s*[a-z0-9\\-]+=[a-z0-9\\-]+)?$"
                      },
                      "version": {
                        "default": "1.0.0",
                        "type": "string",
                        "enum": [
                          "1.0.0"
                        ]
                      },
                      "requestEncoding": {
                        "default": "KVP",
                        "type": "string",
                        "enum": [
                          "KVP",
                          "REST"
                        ]
                      },
                      "urlTemplate": {
                        "type": "string",
                        "minLength": 1
                      },
                      "crs": {
                        "type": "string",
                        "minLength": 3
                      },
                      "tileSize": {
                        "default": 256,
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 256
                          },
                          {
                            "type": "number",
                            "const": 512
                          }
                        ]
                      },
                      "tileMatrixTemplate": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dimensions": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "queryable": {
                        "default": false,
                        "type": "boolean"
                      },
                      "infoFormats": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 3
                        }
                      }
                    },
                    "required": [
                      "layer",
                      "tileMatrixSet"
                    ]
                  }
                },
                "required": [
                  "type",
                  "url",
                  "options"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "XYZ"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "urlTemplate": {
                        "type": "string",
                        "minLength": 1
                      },
                      "scheme": {
                        "default": "xyz",
                        "type": "string",
                        "enum": [
                          "xyz",
                          "tms"
                        ]
                      },
                      "subdomains": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "tileSize": {
                        "default": 256,
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 256
                          },
                          {
                            "type": "number",
                            "const": 512
                          }
                        ]
                      },
                      "apiKeyParam": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "urlTemplate"
                    ]
                  }
                },
                "required": [
                  "type",
                  "url",
                  "options"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "WFS"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "typeNames": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "version": {
                        "default": "2.0.0",
                        "type": "string",
                        "enum": [
                          "1.0.0",
                          "1.1.0",
                          "2.0.0"
                        ]
                      },
                      "outputFormat": {
                        "default": "application/json",
                        "type": "string"
                      },
                      "crs": {
                        "type": "string",
                        "minLength": 3
                      },
                      "maxFeatures": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 100000
                      },
                      "extraParams": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      }
                    },
                    "required": [
                      "typeNames"
                    ]
                  }
                },
                "required": [
                  "type",
                  "url",
                  "options"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "COG"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "bands": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "nodata": {
                        "type": "number"
                      },
                      "resampling": {
                        "default": "nearest",
                        "type": "string",
                        "enum": [
                          "nearest",
                          "bilinear",
                          "cubic"
                        ]
                      },
                      "crs": {
                        "type": "string",
                        "minLength": 3
                      }
                    },
                    "required": [
                      "url"
                    ]
                  }
                },
                "required": [
                  "type",
                  "url",
                  "options"
                ]
              }
            ]
          },
          "license": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "CC-BY-4.0",
                  "CC-BY-SA-4.0",
                  "CC-BY-3.0",
                  "CC-BY-2.5",
                  "CC0-1.0",
                  "IODL-2.0",
                  "IODL-1.0",
                  "ODbL-1.0",
                  "etalab-2.0",
                  "etalab-1.0",
                  "dl-de-by-2.0",
                  "dl-de-zero-2.0",
                  "OGL-3.0",
                  "NLOD-2.0",
                  "copernicus-free",
                  "inspire-open",
                  "proprietary",
                  "custom",
                  "unknown"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 2
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          },
          "attribution": {
            "type": "string",
            "minLength": 2
          },
          "minZoom": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "maxZoom": {
            "default": 20,
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "resolutionMeters": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "temporal": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              }
            }
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "default": "active",
            "type": "string",
            "enum": [
              "active",
              "experimental",
              "deprecated",
              "offline"
            ]
          },
          "metadataUrl": {
            "type": "string",
            "format": "uri"
          },
          "documentationUrl": {
            "type": "string",
            "format": "uri"
          },
          "lastVerified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "provider",
          "country",
          "bbox",
          "service",
          "license",
          "attribution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scope",
    "title",
    "layers"
  ]
}
